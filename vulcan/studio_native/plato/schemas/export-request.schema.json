{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "uniqueItems": true
        },
        "include_descendants": {
          "type": "boolean"
        },
        "include_hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "layer_ids",
        "include_descendants",
        "include_hidden"
      ]
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "normal_registered",
          "inverse_registered",
          "normal_fullframe",
          "inverse_fullframe",
          "shell_registered"
        ]
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "svg",
          "png",
          "stl"
        ]
      }
    },
    "png_width_px": {
      "type": "integer",
      "minimum": 32,
      "maximum": 8192
    },
    "confirm_loose_parts": {
      "type": "boolean"
    },
    "atomic": {
      "const": true
    }
  },
  "required": [
    "base_revision",
    "selection",
    "families",
    "formats",
    "png_width_px",
    "confirm_loose_parts",
    "atomic"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bulk export request"
}
