{
  "schema": 1,
  "id": "gepetto",
  "name": "Gepetto's Hoard \u00b7 Vulcan's Hoard",
  "purpose": "Drive Gepetto's Hoard's 3D projects, analysis and jobs through its REST API.",
  "capabilities": [
    "projects",
    "analysis",
    "jobs"
  ],
  "placeholders": [
    "COMPAT_DIR",
    "VULCAN_DIR",
    "OWNER_URL",
    "APP_URL",
    "TOKEN_FILE",
    "DATA_DIR",
    "PYTHON"
  ],
  "defaults": {
    "VULCAN_DIR": "{COMPAT_DIR}/../..",
    "OWNER_URL": "http://127.0.0.1:5186",
    "APP_URL": "{OWNER_URL}/compat/gepetto",
    "TOKEN_FILE": "{VULCAN_DIR}/data/mcp-token",
    "DATA_DIR": "{VULCAN_DIR}/data/native/gepetto/data",
    "PYTHON": "{VULCAN_DIR}/venv/Scripts/python.exe"
  },
  "app": {
    "url_default": "{APP_URL}",
    "ui_url": null,
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "vulcan-hoard"
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "-I",
      "-m",
      "vulcan.compat_mcp",
      "--module",
      "gepetto"
    ],
    "env": {
      "VULCAN_URL": "{OWNER_URL}",
      "VULCAN_TOKEN_FILE": "{TOKEN_FILE}"
    }
  },
  "x-family": {
    "standalone": false,
    "agent_contract": true,
    "absorbed_by": {
      "id": "vulcan",
      "module": "gepetto",
      "standalone": false,
      "repository": "https://github.com/Luissalet/VulcanHoard"
    }
  },
  "notes": "Capabilities and native data belong to Vulcan's Hoard. Modules are enabled explicitly in the owner."
}
