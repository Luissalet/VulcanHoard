{
  "schema": 1,
  "id": "vulcan",
  "name": "Vulcan's Hoard",
  "purpose": "3D studio: model library, editable figure relief, image-to-3D generation, silhouette extrusion, measured CAD and terrain/cities. Independent modules initially OFF; shared native projects and retained artifacts.",
  "capabilities": [
    "3d-models",
    "stl",
    "3mf",
    "obj",
    "mesh-metrics",
    "thumbnails",
    "duplicates",
    "near-duplicates",
    "listings",
    "tags",
    "notes",
    "collections",
    "albums",
    "folder-scan",
    "folder-watch",
    "fts-search",
    "stats",
    "folder-listings",
    "cults3d",
    "listing-validator",
    "listing-drafting",
    "listing-export",
    "collection-organizer",
    "organize-plan",
    "organize-undo",
    "sheets-batch",
    "skeleton-listings",
    "3d-studio",
    "editable-relief",
    "blender-projects",
    "image-to-3d",
    "mesh-refinement",
    "silhouette-composition",
    "silhouette-extrusion",
    "parametric-cad",
    "step",
    "terrain",
    "cities",
    "shared-native-projects",
    "retained-artifacts",
    "independent-modules"
  ],
  "placeholders": [
    "VULCAN_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "PYTHON",
    "DATA_DIR"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5186",
    "TOKEN_FILE": "{VULCAN_DIR}/data/mcp-token",
    "PYTHON": "{VULCAN_DIR}/venv/Scripts/python.exe",
    "DATA_DIR": "{VULCAN_DIR}/data"
  },
  "app": {
    "url_default": "http://127.0.0.1:5186",
    "ui_url": "{APP_URL}",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "vulcan-hoard"
      }
    },
    "identify": {
      "service": [
        "vulcan-hoard"
      ],
      "title": [
        "vulcan's hoard",
        "modelos 3d"
      ]
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": [
        "-I",
        "-m",
        "vulcan"
      ],
      "cwd": "{VULCAN_DIR}",
      "readiness": {
        "url": "{APP_URL}/api/health",
        "timeout_s": 30
      },
      "env": {
        "VULCAN_DATA_DIR": "{DATA_DIR}",
        "VULCAN_TOKEN_FILE": "{TOKEN_FILE}"
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "-I",
      "{VULCAN_DIR}/mcp_server.py"
    ],
    "env": {
      "VULCAN_URL": "{APP_URL}",
      "VULCAN_TOKEN_FILE": "{TOKEN_FILE}",
      "VULCAN_DATA_DIR": "{DATA_DIR}"
    },
    "optional_env": []
  },
  "notes": "All six modules and automation initially OFF. Explicitly start Vulcan, then vulcan_set_module for a requested function. Discovery uses the complete owned static catalogue without starting any server or native store. Library tool names are preserved; other module tools retain native names/schemas under namespaces. Shared projects retain IDs/revisions/artifact hashes. Text and vision use Faustus global stateless inference only. Native HTTP editors/APIs use /library/, /gepetto/, /daedalus/, /plato/, /heron/, /gulliver/; host control/project/MCP routes remain /api/. Compatibility aliases and real data migration are coordinated separately.",
  "x-family": {
    "agent_contract": true,
    "events": true,
    "stack": "python",
    "copilot": {
      "contract_version": "1.0",
      "info": "/api/copilot/info",
      "panel": "/api/copilot/panel.js",
      "proxy": "/api/copilot/proxy"
    },
    "modules": [
      "library",
      "gepetto",
      "daedalus",
      "plato",
      "heron",
      "gulliver"
    ]
  }
}
